# Copia este archivo a .env y ajusta los valores.
# El .env real esta en .gitignore y nunca se sube al repositorio.

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=ecommerce
MONGO_INITDB_ROOT_PASSWORD=ecommerce
MONGO_URI=mongodb://ecommerce:ecommerce@localhost:27017/ecommerce?authSource=admin

# --- Seguridad ---
# Clave de firma HS256. Minimo 64 caracteres. Genera una nueva para cualquier despliegue real.
JWT_SECRET=cambia-esta-clave-por-una-cadena-larga-y-aleatoria-de-al-menos-64-caracteres
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Correo (Mailpit en desarrollo) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ecommerce.local

# --- URLs de la aplicacion ---
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:4200

# --- Microservicio NLP (BERT) ---
NLP_SERVICE_URL=http://localhost:8000
NLP_SERVICE_TIMEOUT_MS=4000
